# Copie este archivo a .env (o defina las variables en su sesión) y ajuste los valores.
SITE_ID=PLANTA-01
OPC_ENDPOINT=opc.tcp://localhost:4840/scada-iot/simulador
OPC_NAMESPACE_URI=urn:scada-iot:planta
OPC_ROOT_NAME=Planta
IOT_ENDPOINT=xxxxxxxxxxxxxx-ats.iot.us-east-1.amazonaws.com
IOT_PORT=8883
CERT_FILE=certs/PLANTA-01-certificate.pem.crt
KEY_FILE=certs/PLANTA-01-private.pem.key
CA_FILE=certs/AmazonRootCA1.pem
BUFFER_PATH=data/buffer.db
GATEWAY_BATCH_SIZE=100
GATEWAY_FLUSH_INTERVAL_S=1.0
GATEWAY_INFLIGHT_WINDOW=16
