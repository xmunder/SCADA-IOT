# Entornos y caché
.venv/
__pycache__/
.pytest_cache/
*.pyc

# Credenciales y certificados: nunca se versionan
certs/
*.pem
*.key
*.crt
.env

# Datos locales del buffer y resultados de pruebas
*.db
*.db-wal
*.db-shm

# Resultados de pruebas: solo se versionan las corridas citadas en la documentación (ver loadtest/results/README.md).
# Las demás (cortes que no cortaban, matrices abortadas, validaciones) quedan fuera a propósito.
loadtest/results/*
!loadtest/results/README.md
!loadtest/results/matriz-us-east-2-v2/
!loadtest/results/gateway-200-us-east-2/
!loadtest/results/corte-5min-us-east-2/
!loadtest/results/cold-table-test/
!loadtest/results/cold-table-long/
!loadtest/results/flush-sweep/
!loadtest/results/gateway-1000/
!loadtest/results/observabilidad-fase1/
!loadtest/results/cola-directo/
!loadtest/results/cola-sqs/
!loadtest/results/cola-sqs-c20/
!loadtest/results/fallos-cola/
!loadtest/results/cola-directo-r2/
!loadtest/results/cola-sqs-c20-r2/
!loadtest/results/cola-sqs-c10/
!loadtest/results/cola-sqs-c40/
!loadtest/results/estable-cola-c20/
!loadtest/results/estable-directo/
!loadtest/results/corte-observabilidad/
!loadtest/results/corte-5min-us-east-2-r2/
!loadtest/results/corte-5min-us-east-2-r3/

